# 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
#
# Copy this file as "Makefile" next to the .skin file of your skin. It puts
# the texts of trans('...') and the titles and values of the <option>
# elements into the translation template, builds the translations and
# installs the skin. Directories come from VDR's pkg-config file.

SKIN = $(basename $(wildcard *.skin))
MAIL = $(shell sed -ne "s/.*Report-Msgid-Bugs-To: *<\(..*\)>.*/\1/p" po/*.po | head -n1)

### The directory environment (from vdr.pc if available):

PKGCFG     = $(shell pkg-config --variable=$(1) vdr 2>/dev/null)
VDRCONFDIR ?= $(or $(call PKGCFG,configdir),/var/lib/vdr)
LOCDIR     ?= $(or $(call PKGCFG,locdir),/usr/share/locale)

DESTDIR   ?=
SKINDIR    = $(VDRCONFDIR)/plugins/text2skin/$(SKIN)
THEMESDIR  = $(VDRCONFDIR)/themes

### The main target:

all: i18n

### Internationalization (I18N):

PODIR     = po
LOCALEDIR = locale
I18Npo    = $(notdir $(wildcard $(PODIR)/*.po))
I18Npot   = $(PODIR)/$(SKIN).pot

# texts to translate: trans('...') in the skin, titles and values of the options
$(I18Npot): $(SKIN).skin
	@{ sed -e "s/('/(\"/g;s/')/\")/g" $< | grep -o "trans([^)]*)"; \
	   grep -o '<option [^>]*>' $< | sed -n 's/.* title="\([^"]*\)".*/trans("\1")/p'; \
	   grep -o '<option [^>]*>' $< | sed -n 's/.* values="\([^"]*\)".*/\1/p' | tr ',' '\n' | sed 's/.*/trans("&")/'; } | \
	xgettext -C --no-wrap --no-location -k -ktrans --from-code=UTF-8 \
	         --msgid-bugs-address='<$(MAIL)>' -o $@ -

%.po: $(I18Npot)
	msgmerge -U --no-wrap --no-location --backup=none -q $@ $<
	@touch $@

$(LOCALEDIR)/%/LC_MESSAGES/vdr-text2skin-$(SKIN).mo: $(PODIR)/%.po
	@mkdir -p $(dir $@)
	msgfmt -c -o $@ $<

i18n: $(I18Npo:%.po=$(LOCALEDIR)/%/LC_MESSAGES/vdr-text2skin-$(SKIN).mo)

install-i18n: i18n
	@mkdir -p $(DESTDIR)$(LOCDIR)
	@cp -r $(LOCALEDIR)/* $(DESTDIR)$(LOCDIR)

### Targets:

# everything but the build files goes into the skin folder, themes/*.theme
# (if any) into VDR's themes folder
INSTALLFILES = $(filter-out Makefile $(PODIR) $(LOCALEDIR) themes,$(wildcard *))

install: install-i18n
	@mkdir -p $(DESTDIR)$(SKINDIR)
	@cp -r $(INSTALLFILES) $(DESTDIR)$(SKINDIR)
ifneq ($(wildcard themes/*.theme),)
	@mkdir -p $(DESTDIR)$(THEMESDIR)
	@cp themes/*.theme $(DESTDIR)$(THEMESDIR)
endif

clean:
	@-rm -rf $(LOCALEDIR) $(I18Npot) *~

.PHONY: all i18n install install-i18n clean
